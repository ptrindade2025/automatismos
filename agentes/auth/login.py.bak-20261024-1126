"""Autenticação no Zap Agentes PP (portal web), segundo a norma de asserções de 2026-10-24.

Origem: _comum/scripts/agentes-pp/login.py e visivel.py, _comum/scripts/aw_login_mfa.py,
P0733-seguranca-zap-agentes/scripts/mfa_707_712.py. Migrado a 24/10/2026: esperas fixas
substituídas por asserções web-first (`expect`); sem fallback silencioso de seletores.
Credenciais só por variáveis de ambiente (por omissão AW_USER e AW_PASS; PIN em AW_PIN).

## login_credenciais(pg, base_url, utilizador_env, password_env, url_esperado=None) -> str
- **Resultado esperado:** ecrã /login com os campos visíveis antes de submeter; depois de submeter,
  se `url_esperado` (regex) for indicado, `expect(page).to_have_url(url_esperado)`. Devolve pg.url.
## escolher_email(pg) / pedir_codigo(pg)
- Escolhe o canal «E-mail» e carrega em «Enviar»; espera o texto «Introduza o código».
## preencher_codigo(pg, codigo)
- Exige 6 campos [data-role="mfa-digit"]; falha se não existirem (sem fallback).
## validar_codigo(pg, codigo, url_esperado=None)
- Preenche, carrega em «Validar» e, se indicado, verifica o URL de destino.
## login_mfa_email(pg, endereco, ...) -> True
- **Resultado esperado:** /login/mfa com «Introduza o código»; após validar, URL sem /login.
- **Casos que o usam:** SZA-701, 702, 703, 706, 707, 712, 715 (suite 263).

Seletores: os campos de login não têm label/data-testid confirmados; usam os id estáveis
(`#input-login-username`, `#input-login-password`, `#btn-login-submit`) — substituir por
`get_by_label`/`data-testid` quando a DEV os expuser («a confirmar»).
"""
import re
from playwright.sync_api import expect
from automacao._comum.config import AW_URL_PP, env
from automacao.agentes.auth.codigo_mfa import max_email_id, ler_codigo_email

URL_LOGIN = re.compile(r"/login/?(\?.*)?$")
URL_MFA = re.compile(r"/login/mfa(/channel)?/?(\?.*)?$")
URL_PORTAL = re.compile(r"^(?!.*/login).*$")
TXT_INTRODUZA = "Introduza o código"

CAMPO_UTILIZADOR = "#input-login-username"
CAMPO_PASSWORD = "#input-login-password"
BOTAO_ENTRAR = "#btn-login-submit"


def login_credenciais(pg, base_url: str = AW_URL_PP, utilizador_env: str = "AW_USER",
                      password_env: str = "AW_PASS", url_esperado=None, utilizador: str | None = None) -> str:
    pg.goto(base_url + "/login")
    # Esperado: ecrã /login com utilizador e palavra-passe visíveis
    expect(pg).to_have_url(URL_LOGIN)
    expect(pg.locator(CAMPO_UTILIZADOR)).to_be_visible()
    expect(pg.locator(CAMPO_PASSWORD)).to_be_visible()
    pg.locator(CAMPO_UTILIZADOR).fill(utilizador or env(utilizador_env))
    pg.locator(CAMPO_PASSWORD).fill(env(password_env))
    pg.locator(BOTAO_ENTRAR).click()
    pg.wait_for_load_state("networkidle")
    if url_esperado is not None:
        # Esperado: destino indicado pelo caso (ex.: /login/mfa ou portal)
        expect(pg).to_have_url(url_esperado)
    return pg.url


def escolher_email(pg) -> None:
    canal = pg.get_by_label(re.compile(r"^\s*E-mail\s*$"))
    expect(canal).to_be_visible()
    canal.check()
    # Esperado: canal E-mail selecionado
    expect(canal).to_be_checked()


def pedir_codigo(pg) -> None:
    enviar = pg.get_by_role("button", name=re.compile(r"^\s*Enviar", re.I))
    expect(enviar).to_be_enabled()
    enviar.click()
    # Esperado: ecrã do código com «Introduza o código»
    expect(pg.get_by_text(TXT_INTRODUZA)).to_be_visible()


def preencher_codigo(pg, codigo: str) -> None:
    if not re.fullmatch(r"\d{6}", codigo):
        raise ValueError("o código MFA tem de ter 6 dígitos")
    digitos = pg.locator('[data-role="mfa-digit"]')
    # Esperado: 6 campos de dígito ativos
    expect(digitos).to_have_count(6)
    for i, c in enumerate(codigo):
        expect(digitos.nth(i)).to_be_enabled()
        digitos.nth(i).fill(c)


def validar_codigo(pg, codigo: str, url_esperado=None) -> None:
    preencher_codigo(pg, codigo)
    pg.get_by_role("button", name=re.compile("Validar", re.I)).click()
    pg.wait_for_load_state("networkidle")
    if url_esperado is not None:
        expect(pg).to_have_url(url_esperado)


def login_mfa_email(pg, endereco: str, base_url: str = AW_URL_PP, utilizador_env: str = "AW_USER",
                    password_env: str = "AW_PASS", espera: int = 25) -> bool:
    login_credenciais(pg, base_url, utilizador_env, password_env, url_esperado=URL_MFA)
    escolher_email(pg)
    antes = max_email_id(endereco)
    pedir_codigo(pg)
    codigo, _ = ler_codigo_email(endereco, antes, espera)
    if not codigo:
        raise AssertionError(f"código MFA não chegou à notification_email em {espera} s")
    # Esperado: acesso ao portal (URL sem /login)
    validar_codigo(pg, codigo, url_esperado=URL_PORTAL)
    return True
